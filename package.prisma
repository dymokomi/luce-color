#prisma 4.0
def package "luce-color" {
    str owner = "dymokomi"
    str version = "0.4.0"
    str kind = "package"
    str language = "luce-base"
    str description = "Color science in Luce Base: XYZ with derived matrices and Bradford adaptation, sRGB/P3/Adobe/Rec.2020/ACES/ProPhoto spaces, sRGB/gamma/PQ/HLG curves, CIELAB with CIEDE2000, Oklab, CAM16 and CAM16-UCS, HSV/HSL, OCIO-style conversion."
    str readme = "README.md"
    str[] public = ["cam16", "color", "hsl", "lab", "oklab", "space", "transfer", "xyz"]

    def dependency "luce-std" {
        str owner = "dymokomi"
        str version = "^0.4.0"
        str path = "../luce-std"
    }
}
