## Spectra: light and surfaces sampled across the visible range, the CIE 1931
## standard observer that turns them into XYZ, black-body light, and spectral
## upsampling, which finds a plausible smooth spectrum for a color so that
## something with its own spectral response (a film emulsion, a camera) can be
## exposed to it. The upsampling follows Jakob & Hanika, "A Low-Dimensional
## Function Space for Efficient Spectral Upsampling" (2019): a spectrum is a
## sigmoid of a quadratic in wavelength, three coefficients fitted to the color.
from luce_std import math
import memory
from xyz import XYZ, Chromaticity
import temperature

# mark: Sampling ==============================================================

## Spectra are sampled every 5 nm from 380 nm to 780 nm.
pub let samples: usize = 81
pub let first_nm: f64 = 380.0
pub let step_nm: f64 = 5.0

## Sample `at`'s wavelength in nm.
pub func wavelength(at: usize) -> f64:
    return first_nm + step_nm * (f64)at

## A spectrum: spectral power (light) or reflectance (a surface) per sample.
pub struct Spectrum:
    pub var values: f64[81]

    ## The XYZ of light with this spectrum: the observer's sums. A spectrum from
    ## `planck` or `Upsampler` has Y = 1.
    pub func xyz() -> XYZ:
        var out = XYZ(0.0, 0.0, 0.0)
        for at in 0..<samples:
            out.x += self.values[at] * observer[at * 3]
            out.y += self.values[at] * observer[at * 3 + 1]
            out.z += self.values[at] * observer[at * 3 + 2]
        return out

    ## The sum of this spectrum times `response`, sample by sample: how strongly
    ## a sensor with that spectral response is exposed to it.
    pub func dot(response: const f64[81]) -> f64:
        var sum = 0.0
        for at in 0..<samples:
            sum += self.values[at] * response[at]
        return sum

## The CIE 1931 2° standard observer's color-matching functions x̄, ȳ, z̄,
## interleaved, at the samples (CIE 15:2004, 5 nm).
pub let observer: f64[243] = [
