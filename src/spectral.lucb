# mark: Light =================================================================

## Black-body (Planckian) light at `kelvin`, scaled to Y = 1.
pub func planck(kelvin: f64) -> Spectrum:
    var out: Spectrum
    for at in 0..<samples:
        let metres = wavelength(at) * 1.0e-9
        out.values[at] = 1.0 / (metres * metres * metres * metres * metres * (math.exp(1.4387769e-2 / (metres * kelvin)) - 1.0))
    let y = out.xyz().y
    for at in 0..<samples:
        out.values[at] /= y
    return out

## CIE daylight's basis S0, S1, S2 (CIE 15:2004, linearly interpolated to 5 nm),
## one after the other.
let daylight_basis: f64[243] = [
    63.4, 64.6, 65.8, 80.3, 94.8, 99.8, 104.8, 105.35, 105.9, 101.35, 96.8, 105.35, 113.9, 119.75, 125.6, 125.55,
