pub let signature_cmy: u32 = 0x434D5920
## nCLR for n from 2 to 15 is `0x30434C52 + n` up to 9, then 0x41434C52 for 10 to 0x46434C52.
pub let signature_2clr: u32 = 0x32434C52
pub let signature_15clr: u32 = 0x46434C52

